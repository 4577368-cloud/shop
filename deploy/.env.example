# ============================================================
# TangBuy Plugin 后端 — 阿里云 ECS 环境变量
# 用法：复制此文件为 .env，填入真实值
# ============================================================

# --- Spring 配置 ---
SPRING_PROFILES_ACTIVE=prod
# 2核4G 不再需要 Render 的极限省内存参数，适当放大
JAVA_OPTS=-XX:MaxRAMPercentage=60.0 -XX:InitialRAMPercentage=30.0 -XX:MaxMetaspaceSize=200m -XX:+UseG1GC -XX:+ExitOnOutOfMemoryError

# --- Render PostgreSQL 外部连接（从 Render Dashboard 获取）---
# 登录 Render → tangbuy-db → Connect 页面，填入以下值：
DB_HOST=dpg-xxxxxxxxxx.render.com
DB_PORT=5432
DB_NAME=tangbuy
SPRING_DATASOURCE_USERNAME=tangbuy
SPRING_DATASOURCE_PASSWORD=你的Render数据库密码

# --- 内部接口鉴权 ---
TANG_PLUGIN_INTERNAL_TOKEN=你的内部token

# --- Shopify OAuth ---
TANG_PLUGIN_SHOPIFY_API_KEY=你的Shopify API Key
TANG_PLUGIN_SHOPIFY_API_SECRET=你的Shopify API Secret
# ⚠️ 临时用 IP+端口，后续绑定域名后改为 https://api.tangbuy.com/api/plugin/shopify/auth/callback
TANG_PLUGIN_SHOPIFY_REDIRECT_URI=http://你的ECS公网IP:8088/api/plugin/shopify/auth/callback
TANG_PLUGIN_SHOPIFY_WEBHOOK_BASE_URL=http://你的ECS公网IP:8088

# --- 前端地址（不变）---
TANG_PLUGIN_FRONTEND_BASE_URL=https://ai.tangbuy.com

# --- Tangbuy 商城网关 ---
TANG_PLUGIN_TANGBUY_MALL_SOURCE=gateway
TANG_PLUGIN_TANGBUY_MALL_GATEWAY_BASE_URL=https://tangbuy.cc
TANG_PLUGIN_TANGBUY_MALL_BASE_URL=https://admin.tangbuy.cc
TANG_PLUGIN_TANGBUY_MALL_TOKEN=你的Tangbuy商城token

# --- JWT 密钥（>=32字符，与 Render 上的一致）---
TANG_PLUGIN_JWT_SECRET=你的JWT密钥

# --- Cookie 跨站配置 ---
# 临时用 IP+端口时，与前端 ai.tangbuy.com 仍然跨站，保持 none
TANG_PLUGIN_COOKIE_SAMESITE=none

# --- CORS 白名单 ---
TANG_PLUGIN_CORS_ALLOWED_ORIGINS=https://ai.tangbuy.com,http://localhost:3000

# --- PayPal ---
TANG_PLUGIN_PAYPAL_MODE=sandbox
TANG_PLUGIN_PAYPAL_CLIENT_ID=你的PayPal Client ID
TANG_PLUGIN_PAYPAL_CLIENT_SECRET=你的PayPal Secret
TANG_PLUGIN_PAYPAL_USD_TO_CNY_RATE=6.43
TANG_PLUGIN_PAYPAL_WEBHOOK_ID=你的PayPal Webhook ID

# --- pipispy 运营中心 ---
TANG_PLUGIN_PIPIADS_API_KEY=你的pipispy API Key
